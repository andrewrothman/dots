#!/bin/sh

# Encrypts stdin with the recipient's RSA public key.
# Usage: cat file | rsa-enc <path-to-public-key.pub.pem> > file.enc
# Example: cat file | rsa-enc filesharing.andrew.pub.pem > file.andrew.enc

if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <public_key.pem>" >&2
    exit 1
fi

PUBKEY=$1

openssl pkeyutl -encrypt -pubin -inkey "$PUBKEY" | base64
